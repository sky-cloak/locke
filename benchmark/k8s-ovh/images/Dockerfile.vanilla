FROM quay.io/keycloak/keycloak:26.6.1 AS build
COPY dataset.jar /opt/keycloak/providers/keycloak-benchmark-dataset.jar
RUN /opt/keycloak/bin/kc.sh build --db=postgres --cache=ispn --health-enabled=true --metrics-enabled=true
FROM quay.io/keycloak/keycloak:26.6.1
COPY --from=build /opt/keycloak/ /opt/keycloak/
ENTRYPOINT ["/opt/keycloak/bin/kc.sh","start","--optimized"]
